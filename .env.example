# Copy this file to .env.local and fill in the values.
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public URL of the app (used for email confirmation links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only — never expose to the browser. Used by the check engine.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret the GitHub Actions scheduler sends to /api/cron/check (Phase 3)
CRON_SECRET=generate-a-long-random-string

# Resend — email alerts (resend.com → API Keys)
RESEND_API_KEY=
# Without a verified domain, Resend only sends from onboarding@resend.dev to your own Resend email.
ALERT_FROM_EMAIL=NEONDEV Pulse <onboarding@resend.dev>
# Dev only: send every alert to this address instead of the monitor owner.
ALERT_TEST_TO=
